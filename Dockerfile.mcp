# MCP server image — hand this to devleads so they need no local Python setup.
# The MCP speaks JSON-RPC over stdio, so the client launches it per session with
#   docker run -i --rm ...   (note: -i, and NO -t — a TTY would corrupt the stream)
FROM python:3.12-slim

WORKDIR /app

COPY requirements-mcp.txt .
RUN pip install --no-cache-dir -r requirements-mcp.txt

COPY bot.py mcp_server.py ./

# Unbuffered so stderr diagnostics stream to the client's MCP log pane promptly.
# (stdout stays pure JSON-RPC — bot.py's logging is rerouted to stderr in the code.)
ENV PYTHONUNBUFFERED=1

ENTRYPOINT ["python", "mcp_server.py"]
