# ---- Slack (same workspace as the target channel!) ----
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-socket-mode-app-token
SLACK_CHANNEL_ID=C0123456789        # one id, or comma-separated list

# ---- Anthropic ----
ANTHROPIC_API_KEY=sk-ant-xxxxx
ANTHROPIC_MODEL=claude-haiku-4-5    # optional override (must be vision-capable to read screenshots)
CLASSIFY_VISION=1                   # 1 = pass screenshots to the classifier; set 0 for a text-only model

# ---- Google Sheets ----
SHEET_ID=1AbC...your-sheet-id
SHEET_GID=670955338   # numeric gid of the tab (from the URL); more robust than name
SHEET_TAB=Open Questions
GOOGLE_APPLICATION_CREDENTIALS=secrets/service_account.json

# ---- MCP server (manual-control tools via Claude; see docs/mcp.md) ----
# Channel the MCP posts new questions / reports to. Defaults to the first
# SLACK_CHANNEL_ID above if left blank.
MCP_CHANNEL_ID=
# Slack member id to @-tag on ping and the weekly report (e.g. the owner's id).
# Find it in Slack: profile, overflow menu, Copy member ID. If blank,
# PING_USER_NAME is used as plain text instead of a real mention.
PING_USER_ID=
PING_USER_NAME=the owner

# ---- Remote MCP over HTTP (optional; see docs/operations.md) ----
# Required to start `mcpserver --http`. A long random secret; every request must
# send `Authorization: Bearer <this>`. The server refuses to start without it.
MCP_HTTP_TOKEN=
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=8787

# ---- Behavior (all optional) ----
TZ=UTC                # drives "today" and aging math
BACKFILL_HOURS=24     # scan this many hours of history on boot (0 = off)
AGING_DAYS=3          # ">3 days still open" threshold
MIN_MESSAGE_CHARS=25  # pre-filter: skip shorter top-level messages
WINDOW_DEFAULT=       # on-call window written on new rows (blank = leave for a human)
OWNER_DEFAULT=Unassigned  # Owner on a freshly auto-logged row
AUDIT_LOG_PATH=audit.jsonl
